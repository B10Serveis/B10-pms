<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="ReservationListScreen" owl="1">
        <div class="partnerlist-screen screen">
            <div class="screen-content">
                <div class="top-content">
                    <div
                        t-if="isNextButtonVisible"
                        t-on-click="clickNext"
                        class="button next highlight"
                    >
                        <t t-if="!env.isMobile">
                            <t t-esc="nextButton.text" />
                        </t>
                        <t t-else="">
                            <i
                                t-if="nextButton.command === 'deselect'"
                                class="fa fa-trash"
                            />
                            <i
                                t-if="nextButton.command === 'set'"
                                class="fa fa-check"
                            />
                        </t>
                    </div>
                    <div class="button back" t-on-click="back">
                        <t t-if="!env.isMobile">Discard</t>
                        <t t-else="">
                            <i class="fa fa-undo" />
                        </t>
                    </div>
                    <div
                        class="search-bar-container sb-partner"
                        t-if="!state.detailIsShown"
                    >
                        <div class="pos-search-bar">
                            <input
                                t-ref="search-word-input-reservation"
                                placeholder="Search Reservations..."
                                size="1"
                                t-on-keyup="updateReservationList"
                            />
                        </div>
                    </div>
                </div>
                <section class="full-content">
                    <div class="partner-window">
                        <section class="subwindow collapsed">
                            <div class="subwindow-container collapsed">
                                <div
                                    t-if="state.detailIsShown"
                                    class="partner-details-contents subwindow-container-fix"
                                >
                                    <ReservationDetailsEdit
                                        t-props="state.editModeProps"
                                        onCancel.bind="cancelEdit"
                                    />
                                </div>
                            </div>
                        </section>
                        <section class="subwindow list">
                            <div class="subwindow-container">
                                <div
                                    t-if="!state.detailIsShown"
                                    class="subwindow-container-fix scrollable-y"
                                >
                                    <table class="partner-list">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Partner name</th>
                                                <th>Room</th>
                                                <th>Checkin</th>
                                                <th>Checkout</th>
                                                <th>Adults</th>
                                                <th>Children</th>
                                            </tr>
                                        </thead>
                                        <tbody class="partner-list-contents">
                                            <tr t-if="state.isLoading">
                                                <td colspan="7">Loading reservations…</td>
                                            </tr>
                                            <tr t-if="state.loadError">
                                                <td colspan="7">
                                                    <span t-esc="state.loadError" />
                                                    <button t-on-click="refreshReservations">Retry</button>
                                                </td>
                                            </tr>
                                            <tr t-if="!state.isLoading and !state.loadError and !reservations.length">
                                                <td colspan="7">
                                                    No current reservations found for this POS company and allowed properties.
                                                </td>
                                            </tr>
                                            <t
                                                t-foreach="reservations"
                                                t-as="reservation"
                                                t-key="reservation.id"
                                            >
                                                <ReservationLine
                                                    reservation="reservation"
                                                    selectedReservation="state.selectedReservation"
                                                    detailIsShown="state.detailIsShown"
                                                    onClickReservation.bind="clickReservation"
                                                    onClickEdit.bind="editReservation"
                                                />
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </section>
                    </div>
                </section>
            </div>
        </div>
    </t>

</templates>
