<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mossos_preview" model="ir.ui.view">
        <field name="name">pms.mossos.preview.form</field>
        <field name="model">pms.mossos.preview</field>
        <field name="arch" type="xml">
            <form string="Mossos: preview arrivals">
                <div class="alert alert-info">Shows actual arrivals on the selected day in the establishment timezone.</div>
                <group>
                    <field name="pms_property_id" domain="[('mossos_enabled', '=', True)]"/>
                    <field name="through_date"/>
                    <field name="include_previous_arrivals"/>
                    <div class="alert alert-warning" attrs="{'invisible': [('include_previous_arrivals', '=', False)]}">Review of earlier arrivals: includes previous stays, including departed travellers. Communication history is not yet available; verify whether each arrival was already submitted before using it.</div>
                    <field name="configuration_errors"/>
                </group>
                <button name="action_preview" type="object" string="Refresh pending arrivals" class="btn-primary"/>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0" decoration-danger="errors != False">
                        <field name="selected"/>
                        <field name="checkin_partner_id"/>
                        <field name="firstname"/>
                        <field name="lastname"/>
                        <field name="document_number"/>
                        <field name="reservation_id"/>
                        <field name="arrival_local"/>
                        <field name="ine_municipality_code"/>
                        <field name="mossos_payment_type"/>
                        <field name="mossos_payment_source"/>
                        <field name="mossos_payment_reference" optional="hide"/>
                        <field name="errors"/>
                    </tree>
                </field>
                <footer><button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="action_mossos_preview" model="ir.actions.act_window">
        <field name="name">Mossos: preview arrivals</field>
        <field name="res_model">pms.mossos.preview</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_mossos_preview" name="Mossos: preview arrivals" parent="pms.menu_reservations" action="action_mossos_preview" sequence="32" groups="pms.group_pms_user"/>
</odoo>
