<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_mode_form_mossos" model="ir.ui.view">
        <field name="name">account.payment.mode.form.mossos</field>
        <field name="model">account.payment.mode</field>
        <field name="inherit_id" ref="account_payment_mode.account_payment_mode_form"/>
        <field name="arch" type="xml">
            <field name="payment_type" position="after">
                <field name="mossos_payment_type"/>
            </field>
        </field>
    </record>
    <record id="account_payment_form_mossos_mode" model="ir.ui.view">
        <field name="name">account.payment.form.mossos.mode</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="payment_mode_id" domain="[('company_id', '=', company_id), ('payment_type', '=', payment_type)]"/>
            </field>
        </field>
    </record>
    <record id="wizard_payment_folio_mossos_mode" model="ir.ui.view">
        <field name="name">wizard.payment.folio.mossos.mode</field>
        <field name="model">wizard.payment.folio</field>
        <field name="inherit_id" ref="pms.wizard_payment_folio_view_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="company_id" invisible="1"/>
                <field name="payment_method_id" invisible="1"/>
                <field name="payment_mode_id" domain="[('company_id', '=', company_id), ('payment_type', '=', 'inbound'), ('payment_method_id', '=', payment_method_id)]"/>
            </field>
        </field>
    </record>
</odoo>
