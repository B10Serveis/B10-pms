<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pms_checkin_regularization_view_form" model="ir.ui.view">
        <field name="name">pms.checkin.regularization.form</field>
        <field name="model">pms.checkin.regularization</field>
        <field name="arch" type="xml">
            <form string="Regularize arrival and departure">
                <group>
                    <field name="reservation_id" readonly="1" force_save="1" />
                    <field name="checkin_partner_ids" widget="many2many_tags"
                        context="{'show_guest_name': True}"
                        domain="[('reservation_id', '=', reservation_id), ('state', '=', 'precheckin')]"
                        options="{'no_create': True, 'no_open': True}" />
                    <field name="arrival" />
                    <field name="has_departed" />
                    <field name="departure" attrs="{'invisible': [('has_departed', '=', False)], 'required': [('has_departed', '=', True)]}" />
                    <field name="outside_reservation" invisible="1" />
                </group>
                <div class="alert alert-warning" attrs="{'invisible': [('outside_reservation', '=', False)]}">
                    The actual dates fall outside the reserved stay. Review the reservation dates. Regularization does not change the reserved dates.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Regularize" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
